# --- Required ---
# Neon: use the *pooled* connection string (host contains "-pooler") for Vercel.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Long random string used to sign login tokens:  openssl rand -base64 48
JWT_SECRET=change-me

# --- Optional ---
# Public URL of the deployed site (used for Stripe redirects & links). Defaults to the request origin.
APP_URL=http://localhost:5173
# Photo uploads (Vercel Blob). Without it agents can still paste image URLs.
BLOB_READ_WRITE_TOKEN=
# Premium billing (Stripe Checkout + Customer Portal). Use a *test* key (sk_test_…) for the sandbox:
#   STRIPE_SECRET_KEY=sk_test_… npm run stripe:setup     (creates the ฿299/month price; the app finds it by lookup key)
# STRIPE_PRICE_ID is optional (the app auto-finds the price created by stripe:setup).
# STRIPE_WEBHOOK_SECRET: only needed for webhooks (`stripe listen` locally); the app also syncs when you return from Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Without Stripe configured, ALLOW_DEV_UPGRADE=true lets you flip plans for local testing. Ignored in Vercel production.
ALLOW_DEV_UPGRADE=false
# Browser/mobile origin(s) allowed to call the API cross-origin (comma separated), e.g. capacitor://localhost,http://localhost
CORS_ORIGINS=capacitor://localhost,http://localhost,https://localhost

# Email verification (Resend, https://resend.com). With RESEND_API_KEY set, new accounts must click the emailed link
# before they can sign in. Leave it unset and verification is OFF (accounts are active immediately).
#   EMAIL_FROM must be an address on a domain verified in Resend; the default sender (onboarding@resend.dev)
#   can only deliver to your own Resend account email, which is fine for a first test.
RESEND_API_KEY=
EMAIL_FROM=Khondo <hello@your-domain.com>
# Local dev without a provider: EMAIL_VERIFICATION=console prints the verification link in the API log.
EMAIL_VERIFICATION=

# --- Frontend (build time) ---
# Leave empty for the web app (same origin). Set to https://your-app.vercel.app in the mobile (Capacitor) build.
VITE_API_URL=
